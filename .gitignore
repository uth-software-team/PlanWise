# ==============================================================================
# PlanWise - Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (Keep .env.example tracked)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
!*.env.example
!**/.env.example

# Credentials & Keys
*.pem
*.key
*.p12
*.jks

# ------------------------------------------------------------------------------
# IDEs & Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/
*.code-workspace

# JetBrains IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse / Spring Tool Suite (STS)
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# ------------------------------------------------------------------------------
# Java & Gradle (Backend)
# ------------------------------------------------------------------------------
*.class
*.log
*.ctxt

# Mobile Tools for Java
.mtj.tmp/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# Gradle directory and cache
.gradle/
**/build/
!**/src/main/**/build/
!**/src/test/**/build/

# Crash logs
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# Node.js & Frontend
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
.pnp
.pnp.js

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# Build outputs
dist/
dist-ssr/
build/
.next/
.nuxt/
.output/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Framework caches
.turbo/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# Database & Docker Local Artifacts
# ------------------------------------------------------------------------------
*.h2.db
planwise.mv.db
planwise.trace.db
docker-data/
postgres-data/
