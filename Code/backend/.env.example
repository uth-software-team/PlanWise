SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/planwise_ai
DB_USERNAME=planwise_user
DB_PASSWORD=change-me-local-db-password
# Optional, used by compose.yaml (keep in sync with DB_URL):
# DB_NAME=planwise_ai
# DB_PORT=5432
JPA_DDL_AUTO=validate
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_EXPIRATION_MINUTES=1440
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional. Leave empty to use FakeAiClient.
GEMINI_API_KEY=
