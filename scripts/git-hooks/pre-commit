#!/usr/bin/env bash
# PlanWise Git Flow guard: block commits on protected branches and sensitive/generated files.
set -euo pipefail

RED='\033[0;31m'; YELLOW='\033[1;33m'; NC='\033[0m'

branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo '')"
if [[ "$branch" == "main" || "$branch" == "develop" ]]; then
  echo -e "${RED}✘ Không được commit trực tiếp lên '$branch'.${NC}"
  echo -e "  Tạo nhánh từ develop:  ${YELLOW}git checkout develop && git pull && git checkout -b feature/<module>-<desc>${NC}"
  exit 1
fi

blocked=()
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  base="$(basename "$f")"
  if [[ "$base" =~ ^\.env(\..+)?$ && "$base" != ".env.example" ]] \
     || [[ "$base" =~ \.(pem|key|p12|jks)$ ]] \
     || [[ "$base" == ".DS_Store" ]] \
     || [[ "$f" =~ (^|/)(build|out|target|dist|node_modules|\.gradle|\.idea)/ ]]; then
    blocked+=("$f")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

if (( ${#blocked[@]} > 0 )); then
  echo -e "${RED}✘ Phát hiện file nhạy cảm / build output / file hệ thống trong commit:${NC}"
  printf '  - %s\n' "${blocked[@]}"
  echo -e "  Bỏ khỏi stage:  ${YELLOW}git restore --staged <file>${NC}"
  exit 1
fi

exit 0
