#!/usr/bin/env bash
# PlanWise Git Flow guard: enforce Conventional Commits.
set -euo pipefail

RED='\033[0;31m'; YELLOW='\033[1;33m'; NC='\033[0m'

subject="$(grep -v '^#' "$1" | head -n 1)"

# Allow commits generated by git itself.
if [[ "$subject" =~ ^(Merge |Revert |fixup! |squash! ) ]]; then
  exit 0
fi

pattern='^(feat|fix|test|refactor|docs|chore|build)(\([a-z0-9-]+\))?!?: .{1,100}$'
if [[ ! "$subject" =~ $pattern ]]; then
  echo -e "${RED}✘ Commit message không đúng Conventional Commits:${NC} $subject"
  echo -e "  Định dạng: ${YELLOW}type(scope): summary${NC}  (summary tối đa 100 ký tự)"
  echo    "  type: feat | fix | test | refactor | docs | chore | build"
  echo -e "  Ví dụ:    ${YELLOW}feat(schedule): add conflict check on confirm${NC}"
  exit 1
fi

exit 0
